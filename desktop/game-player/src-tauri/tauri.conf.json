{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxShop Game Player",
  "version": "2.0.0-alpha.1",
  "identifier": "com.hexxisstudios.voxshop.game-player",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'unsafe-inline' 'wasm-unsafe-eval'; worker-src blob:; style-src 'unsafe-inline'; img-src data: blob:; media-src data:; connect-src wss: ws://localhost:* ws://127.0.0.1:* ws://[::1]:*; font-src 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../../../src-tauri/icons/icon.ico",
      "../../../src-tauri/icons/32x32.png",
      "../../../src-tauri/icons/128x128.png",
      "../../../src-tauri/icons/128x128@2x.png"
    ],
    "publisher": "Hexxis Studios",
    "shortDescription": "VoxShop standalone game player",
    "longDescription": "Runs self-contained games exported from VoxShop.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
