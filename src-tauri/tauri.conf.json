{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxShop",
  "version": "2.0.0-alpha.1",
  "identifier": "com.hexxisstudios.voxshop",
  "build": {
    "beforeDevCommand": "npm run desktop:dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run desktop:prepare",
    "beforeBundleCommand": "node scripts/collect-desktop-licenses.mjs",
    "frontendDist": "../.voxshop/desktop-runtime/bootstrap"
  },
  "app": {
    "windows": [
      {
        "title": "VoxShop — Hexxis Studios",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "publisher": "Hexxis Studios",
    "shortDescription": "A voxel game engine for Hexxis Studios",
    "longDescription": "Create voxel assets, worlds, and playable games with VoxShop by Hexxis Studios.",
    "targets": ["nsis", "appimage", "deb", "rpm"],
    "externalBin": ["binaries/voxshop-node"],
    "resources": {
      "../.voxshop/desktop-runtime/resources/": ""
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
